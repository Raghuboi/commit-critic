# commit-critic uses an LLM by default.
# Copy to .env or export these values in your shell.

# OpenAI-compatible endpoint (default path)
AI_PROVIDER=openai
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=your-api-key
AI_MODEL=your-model-name

# OpenAI hosted API can omit AI_BASE_URL:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1

# Local OpenAI-compatible server:
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:8081/v1
# AI_MODEL=qwen3.6
# AI_API_KEY=          # optional; only set if your server requires it

# Optional tuning
# AI_TEMPERATURE=0.1
# AI_MAX_TOKENS=4096
# AI_MAX_RETRIES=2
# AI_TIMEOUT_MS=60000
