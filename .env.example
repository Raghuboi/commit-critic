# commit-critic uses an LLM by default.
# Copy to .env or export values in your shell.

# Provider: openai | local | openrouter | llamacpp | lmstudio | vllm | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4.1

# Generation settings
AI_STRICT_MODE=false
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000

# OpenAI-compatible endpoint (works with hosted /v1 providers)
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=your-api-key

# OpenAI direct
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1
# OPENAI_API_KEY=sk-...

# Local OpenAI-compatible server
# AI_PROVIDER=local
# AI_MODEL=local-model
# AI_BASE_URL=http://localhost:8081/v1
# LOCAL_API_KEY=          # optional; only set if your server requires it

# Optional provider-specific local presets
# AI_PROVIDER=llamacpp
# LLAMACPP_BASE_URL=http://localhost:8081/v1
# AI_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# AI_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=           # optional
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
