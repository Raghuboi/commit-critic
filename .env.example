# commit-critic uses an LLM by default.
# Copy this file to .env or export values in your shell.

# Provider: openai | openrouter | local | llamacpp | lmstudio | vllm | ollama
AI_PROVIDER=openai

# Model ID within the selected provider
AI_MODEL=gpt-4.1

# Fail fast on LLM errors instead of falling back to deterministic scoring
AI_STRICT_MODE=false

# Generation settings
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000

# OpenAI
OPENAI_API_KEY=sk-...
# AI_API_KEY=sk-...          # generic alias when AI_PROVIDER=openai

# Hosted OpenAI-compatible API, such as MiniMax or another /v1 chat completions endpoint
# AI_PROVIDER=openai
# AI_MODEL=MiniMax-M2.7
# AI_BASE_URL=https://api.minimax.io/v1
# AI_API_KEY=sk-...          # generic alias for compatible endpoints
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=sk-...      # provider-specific form, takes precedence over AI_API_KEY

# OpenRouter
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_API_KEY=sk-or-...
# AI_API_KEY=sk-or-...       # generic alias when AI_PROVIDER=openrouter

# Local OpenAI-compatible server (llama.cpp, LM Studio, vLLM, Ollama, etc.)
# AI_PROVIDER=local
# AI_MODEL=qwen3.6
# AI_BASE_URL=http://localhost:8081/v1
# LOCAL_API_KEY=             # optional; only set if your server requires it
# AI_API_KEY=                # optional generic alias for local providers

# Local presets with provider-specific base URL variables
# AI_PROVIDER=llamacpp
# LLAMACPP_BASE_URL=http://localhost:8081/v1

# AI_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# AI_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=              # optional; only set if your vLLM server requires it

# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
