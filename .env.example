# commit-critic uses an LLM by default.
# Copy this file to .env or export these values in your shell.

# Provider: openai | openrouter | local
# Backward-compatible aliases accepted: lmstudio | vllm | ollama | llamacpp
AI_PROVIDER=openai

# Model ID within the selected provider
AI_MODEL=gpt-4.1

# Fail fast on LLM errors instead of falling back to deterministic scoring
AI_STRICT_MODE=false

# Generation settings
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_API_KEY=sk-or-...

# Local OpenAI-compatible server (llama.cpp, LM Studio, vLLM, Ollama, etc.)
# AI_PROVIDER=local
# AI_MODEL=qwen3.6
# AI_BASE_URL=http://localhost:8081/v1
# LOCAL_API_KEY=

# Legacy aliases are still recognized for convenience:
# LLAMACPP_BASE_URL=http://localhost:8081/v1
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
